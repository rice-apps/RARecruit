{
  // Backend venv lives in backend/, not the repo root, so point Pylance at it.
  // Windows: run "Python: Select Interpreter" -> backend\.venv\Scripts\python.exe
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
  // Lets Pylance resolve `from app...` imports, which are relative to backend/
  "python.analysis.extraPaths": ["${workspaceFolder}/backend"]
}
