# Copy to .env.local and fill in. Use the DEV Supabase project locally.
# NEXT_PUBLIC_* values are exposed to the browser, so only public values go here.

# Supabase: Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
