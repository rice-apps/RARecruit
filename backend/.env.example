# Copy to .env and fill in. Use the DEV Supabase project locally.

# Supabase: Dashboard -> Project Settings -> API
SUPABASE_URL=
# Server-only: bypasses RLS. Do not put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Allowed CORS origin (the Next.js app)
FRONTEND_ORIGIN=http://localhost:3000

# Google OAuth (for account that owns form and sends GCal invites)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_FORM_ID=
